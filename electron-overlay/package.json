{
  "name": "ltn-overlay",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --dir && codesign --force --deep --sign - 'dist/mac-arm64/LTN Overlay.app'"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.ltn.overlay",
    "productName": "LTN Overlay",
    "mac": {
      "target": "dir",
      "category": "public.app-category.utilities",
      "identity": null
    }
  }
}
