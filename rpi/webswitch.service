[Unit]
Description=Light The Night Web Switch Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/webswitch
ExecStart=/usr/bin/python3 /home/pi/webswitch/webswitch_agent_2025.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
