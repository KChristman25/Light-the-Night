rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /snapshots/{filename} {
      allow read, write: if request.auth != null;
    }
    match /sounds/{filename} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
